# Dashboard CRM Flash — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# IMPORTANT : Ne jamais committer le fichier .env

# --- Identité de l'application ---
VITE_APP_TITLE="CRM Flash"
VITE_APP_VERSION="1.0.0"

# --- Paramètres métier ---
# Devise affichée dans les montants
VITE_CURRENCY="EUR"
# Locale utilisée pour le formatage des dates et montants
VITE_LOCALE="fr-FR"
# Nombre de deals affichés dans le tableau "Top Deals"
VITE_TOP_DEALS_COUNT=5

# --- Seuils d'alerte (V1) ---
# Nombre de jours avant échéance pour déclencher une alerte anticipée
VITE_ALERT_DUE_DAYS_THRESHOLD=3
